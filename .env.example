# SQLite local (padrao; nao exige MySQL)
DATABASE_URL=sqlite:///rotogramas.db
# Para MySQL, substitua por sua conexao local:
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost:3306/rotogramas
SECRET_KEY=SUBSTITUA-POR-UMA-CHAVE-ALEATORIA
FLASK_DEBUG=0

# Rotina interna: 900 segundos = 15 minutos
INTERVALO_VERIFICACAO_SEGUNDOS=900
# Servidor local; configure a rede interna apenas no computador responsavel
HOST=127.0.0.1
PORT=5000

# Integração ORS: ative somente após configurar sua chave no servidor.
ORS_ENABLED=0
ORS_API_KEY=
ORS_RAIO_KM=10
ORS_CACHE_DIAS=30
# Orçamentos conservadores; confira as cotas da sua conta ORS.
ORS_LIMITE_DIA_DIRECTIONS=1000
ORS_LIMITE_DIA_GEOCODE=500
ORS_INTERVALO_REQUISICOES=2.1
# Em uma implantação com HTTPS, defina COOKIE_SECURE=1.
COOKIE_SECURE=0
