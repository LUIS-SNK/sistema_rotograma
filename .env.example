# SQLite local (padrao; nao exige MySQL)
DATABASE_URL=sqlite:///rotogramas.db
# Para MySQL, substitua por sua conexao local:
# DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost:3306/rotogramas
SECRET_KEY=SUBSTITUA-POR-UMA-CHAVE-ALEATORIA
FLASK_DEBUG=0

# Rotina interna: 900 segundos = 15 minutos
INTERVALO_VERIFICACAO_SEGUNDOS=900
# Servidor local; configure a rede interna apenas no computador responsavel
HOST=127.0.0.1
PORT=5000
